{
  "manifest_version": 3,
  "name": "SCOUTS — Планетарная база",
  "short_name": "SCOUTS Planet",
  "version": "1.1.0",
  "description": "Два режима: автоматический снимок планеты и виртуальная стройка. Без устаревшей панели.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://scouts.su/*"
      ],
      "js": [
        "extension/capture-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://scouts.su/*"
      ],
      "js": [
        "extension/bridge-isolated.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://scouts.su/*"
      ],
      "js": [
        "SCOUTS_Planet_Workspace.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
